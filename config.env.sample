# Required Telegram API Credentials (from https://my.telegram.org)
API_ID=6
API_HASH=eb06d4abfb49dc3eeb1aeb98ae0f581e

# Required Bot Token (from @BotFather on Telegram)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Required Pyrogram Session String (generated via @SmartUtilBot /pyro)
SESSION_STRING=BQAF...

# Optional Bot Settings
MAX_CONCURRENT_DOWNLOADS=3
PARALLEL_DOWNLOAD_WORKERS=4
PARALLEL_UPLOAD_WORKERS=4
DOWNLOAD_REQUESTS_PER_CONNECTION=2
UPLOAD_REQUESTS_PER_CONNECTION=4
MAX_ACTIVE_TRANSFERS=2
# One protected-source relay at a time; each still uses all file connections.
SOURCE_RELAY_CONCURRENCY=1
# Retry a Telegram FLOOD_PREMIUM_WAIT after its required wait.
PREMIUM_WAIT_RETRIES=3
TRANSFER_BUFFER_MIB=64
DISK_RESERVE_MIB=256
MAX_CONCURRENT_TRANSMISSIONS=3
BATCH_SIZE=10
FLOOD_WAIT_DELAY=3
PIN_PROMPT_TIMEOUT=60
ERROR_MESSAGE_TTL=300

# Optional Web Health Check Port (default: 8080)
PORT=8080
