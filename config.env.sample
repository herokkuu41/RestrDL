# Required Telegram API Credentials (from https://my.telegram.org)
API_ID=6
API_HASH=eb06d4abfb49dc3eeb1aeb98ae0f581e

# Required Bot Token (from @BotFather on Telegram)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Required Pyrogram Session String (generated via @SmartUtilBot /pyro)
SESSION_STRING=BQAF...

# Optional Bot Settings
MAX_CONCURRENT_DOWNLOADS=3
PARALLEL_DOWNLOAD_WORKERS=4
PARALLEL_UPLOAD_WORKERS=4
# Production uses one request per connection (old 2/4 overrides are ignored).
DOWNLOAD_REQUESTS_PER_CONNECTION=1
UPLOAD_REQUESTS_PER_CONNECTION=1
MAX_ACTIVE_TRANSFERS=2
TRANSFER_BUFFER_MIB=64
DISK_RESERVE_MIB=256
# Separate /batch_watch board export; encoder runs one file globally, 2 threads.
# Size is a maximum: keep native slide detail instead of artificial HD upscaling.
WATCH_BOARD_NATIVE_SIZE=true
## Previous footer layout, now only available in diagnostic probes.
WATCH_BOARD_PIP_FPS=12
# /batch_watch_video: native board + full teacher resolution/source frame rate.
# superfast saves CPU; ultrafast can create excessively large upload files.
WATCH_BOARD_VIDEO_PRESET=superfast
WATCH_BOARD_WIDTH=1920
WATCH_BOARD_HEIGHT=1080
WATCH_BOARD_FPS=8
WATCH_BOARD_CRF=16
# veryfast keeps files compact; superfast trades larger files for extra CPU speed.
WATCH_BOARD_PRESET=veryfast
MAX_CONCURRENT_TRANSMISSIONS=3
BATCH_SIZE=10
FLOOD_WAIT_DELAY=3
PIN_PROMPT_TIMEOUT=60
ERROR_MESSAGE_TTL=300

# Optional Web Health Check Port (default: 8080)
PORT=8080
